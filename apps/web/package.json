{
  "name": "@zombills/web",
  "version": "0.0.0",
  "private": true,
  "description": "The Zombills site. Runs entirely in the browser; statement data never leaves the device.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @zombills/core",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "pretest": "npm run build --workspace @zombills/core",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.e2e.json",
    "test:e2e": "npm run build --workspace @zombills/core && npm run build && playwright test",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "fast-check": "4.10.2",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@fontsource/im-fell-english": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@zombills/core": "0.0.0",
    "framer-motion": "14.14.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
